# Server runtime
PORT=3009
CORS_ORIGIN=http://localhost:3000
# Worker pool
WORKER_CONCURRENCY=3        # jobs processed in parallel by the worker pool
WORKER_AUTOSTART=true       # start consuming on boot (false = enqueue-only until resumed)
POLL_INTERVAL_MS=25         # how often idle workers poll for a job
# Queue semantics
VISIBILITY_TIMEOUT_MS=30000 # a leased job is invisible this long; then the reaper requeues it
BACKOFF_BASE_MS=1000        # retry backoff base (attempt N waits ~base * 2^(N-1) + jitter)
BACKOFF_CAP_MS=30000        # maximum backoff between retries
MAX_QUEUE_DEPTH=10000       # backpressure: reject enqueue when waiting+delayed+active exceeds this
