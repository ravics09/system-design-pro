# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ───────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/user-auth

# ── Rate limiting / cache store ────────────────────────────
# memory = per-process (dev only); redis = shared across instances
RATE_LIMIT_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379

# ── JWT access token ───────────────────────────────────────
# Use a long random secret in production (or switch to RS256 keys).
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_ISSUER=user-auth-service
JWT_AUDIENCE=user-auth-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ── Password reset ─────────────────────────────────────────
RESET_TOKEN_TTL_SECONDS=1800

# ── Refresh cookie ─────────────────────────────────────────
# Set COOKIE_SECURE=true when served over HTTPS.
COOKIE_SECURE=false
# COOKIE_DOMAIN=example.com

# ── Auth endpoint rate limits ──────────────────────────────
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
