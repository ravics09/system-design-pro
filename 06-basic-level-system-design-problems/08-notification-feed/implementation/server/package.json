{
  "name": "realtime-notifications-server",
  "version": "1.0.0",
  "description": "NestJS + Socket.IO + Mongoose + Zod real-time notification API (rooms per user, fan-out, unread counts).",
  "private": true,
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/platform-socket.io": "^10.4.1",
    "@nestjs/websockets": "^10.4.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^5.4.1",
    "mongoose": "^8.5.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "typescript": "^5.5.4"
  }
}
