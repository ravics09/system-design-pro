# Server runtime
PORT=3004
CORS_ORIGIN=http://localhost:3000
# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/realtime-notifications
# Unread-count store: memory (dev) or redis
UNREAD_DRIVER=memory
# WebSocket scale-out adapter: memory (single instance) or redis (multi-instance)
SOCKET_ADAPTER=memory
REDIS_URL=redis://127.0.0.1:6379
# History pagination bounds
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
