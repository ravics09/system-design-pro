{
  "name": "todo-list-api",
  "version": "1.0.0",
  "description": "Reference implementation of a multi-user Todo List API: per-user CRUD, embedded sub-tasks, cursor pagination, filtering/sorting, validation, soft delete.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
}
