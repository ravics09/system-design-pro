# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ───────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/image-upload-service

# ── Object storage (S3) ────────────────────────────────────
AWS_REGION=us-east-1
UPLOAD_BUCKET=image-upload-service-dev
DERIVED_BUCKET=image-upload-service-dev
# For LocalStack / MinIO local testing, e.g. http://localhost:4566
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# AWS credentials come from the standard AWS chain (env, profile, IAM role):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Async processing queue ─────────────────────────────────
# memory = in-process (dev only); sqs = durable production queue
QUEUE_DRIVER=memory
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/image-processing

# ── Rate limiting ──────────────────────────────────────────
# memory = per-process (dev only); redis = shared across instances
RATE_LIMIT_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379

# ── CDN delivery ───────────────────────────────────────────
# CDN_DOMAIN=https://cdn.example.com
# CDN_SIGNING_KEY_ID=APKAXXXXXXXX
# CDN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ── Upload policy ──────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760
PRESIGN_EXPIRES_SECONDS=300
SIGNED_VIEW_EXPIRES_SECONDS=3600
PENDING_TTL_SECONDS=900
