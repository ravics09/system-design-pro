# Server runtime
PORT=3002
CORS_ORIGIN=http://localhost:3000
# Public base used to build the returned short URL
PUBLIC_BASE_URL=http://localhost:3002
# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/url-shortener
# Cache: memory (dev) or redis
CACHE_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379
# Redirect cache TTL (seconds)
CACHE_TTL_SECONDS=3600
# Base62 counter start offset (keeps initial codes a few chars long)
CODE_START_OFFSET=1000000
