{
  "name": "autocomplete-typeahead",
  "version": "1.0.0",
  "private": true,
  "description": "Prefix autocomplete: an in-memory trie returning top-k completions by popularity, fronted by a Redis result cache for hot prefixes.",
  "license": "MIT",
  "author": "Ravi Sharma <ravisharmacs09@gmail.com>",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4"
  }
}
