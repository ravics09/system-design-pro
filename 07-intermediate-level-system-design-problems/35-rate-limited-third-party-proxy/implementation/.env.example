PORT=3135
REDIS_URL=redis://127.0.0.1:6379
# The restrictive external API (a bundled fake upstream by default)
UPSTREAM_URL=http://127.0.0.1:4100
# Shared quota: capacity tokens, refilled at this rate (per second)
RATE_CAPACITY=10
RATE_REFILL_PER_SEC=2
# Cache TTL for upstream responses (seconds)
CACHE_TTL_S=30
