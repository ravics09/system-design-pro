# HTTP + WebSocket port
PORT=3101
# MongoDB connection (message persistence)
MONGODB_URI=mongodb://127.0.0.1:27017/chat
# Redis connection (Socket.IO adapter backplane for multi-instance fan-out)
REDIS_URL=redis://127.0.0.1:6379
# Secret used to sign demo access tokens (HMAC). Change in production.
AUTH_SECRET=dev-chat-secret-change-me
# CORS origin for the browser client
CORS_ORIGIN=*
