PORT=3116
# Upstream service base URLs (in docker-compose these resolve to service names)
USERS_URL=http://127.0.0.1:4001
ORDERS_URL=http://127.0.0.1:4002
# Token required on protected routes (demo)
GATEWAY_TOKEN=dev-token
# Rate limit: token bucket per client IP
RATE_CAPACITY=20
RATE_REFILL_PER_SEC=10
