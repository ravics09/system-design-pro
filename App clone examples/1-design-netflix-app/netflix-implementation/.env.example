# Copy to `.env` (read by docker compose). Only OMDB_API_KEY is really required.

# OMDb API key — get a free one at https://www.omdbapi.com/apikey.aspx
# Without it, auth/profiles/My List still work but browse/search return empty.
OMDB_API_KEY=

# Change this in any real deployment (used to sign access tokens).
JWT_ACCESS_SECRET=change-me-access-secret

# Token lifetimes (seconds)
ACCESS_TTL_S=900
REFRESH_TTL_S=2592000

# OMDb base URL (rarely changed)
OMDB_BASE_URL=https://www.omdbapi.com/

# Where the browser reaches the API (inlined into the web build)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3020
