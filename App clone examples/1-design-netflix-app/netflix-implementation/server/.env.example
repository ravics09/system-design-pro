# ── Server runtime ─────────────────────────────────────────────
PORT=3020
CORS_ORIGIN=http://localhost:3000

# ── MongoDB ────────────────────────────────────────────────────
# Local dev: mongodb://127.0.0.1:27017/netflix
# Docker Compose sets this to the "mongo" service host automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/netflix

# ── Auth / tokens ──────────────────────────────────────────────
# CHANGE THESE in production (use a secret manager). Access tokens are HMAC-signed.
JWT_ACCESS_SECRET=change-me-access-secret
ACCESS_TTL_S=900            # 15 minutes
REFRESH_TTL_S=2592000       # 30 days (refresh tokens are stored hashed + revocable)

# ── OMDb API (movie metadata) ──────────────────────────────────
# Get a free key at https://www.omdbapi.com/apikey.aspx — this is a SECRET, never ship it to the client.
OMDB_API_KEY=
OMDB_BASE_URL=https://www.omdbapi.com/

# ── Catalog cache ──────────────────────────────────────────────
CATALOG_CACHE_TTL_MS=3600000   # 1h in-process TTL cache over OMDb responses

# ── Profiles ───────────────────────────────────────────────────
MAX_PROFILES=5
