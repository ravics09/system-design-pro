# ── Server runtime ─────────────────────────────────────────────
PORT=3021
CORS_ORIGIN=http://localhost:3000

# ── MongoDB ────────────────────────────────────────────────────
# Local dev: mongodb://127.0.0.1:27017/shopping
# Docker Compose sets this to the "mongo" service host automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/shopping

# ── Auth / tokens ──────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
ACCESS_TTL_S=900            # 15 minutes
REFRESH_TTL_S=2592000       # 30 days (refresh tokens stored hashed + revocable)

# ── WooCommerce REST API (product catalog) ─────────────────────
# A hostable WordPress/WooCommerce store. Create REST API keys under
# WooCommerce → Settings → Advanced → REST API. These are SECRETS (server only).
WC_BASE_URL=            # e.g. https://your-store.example.com/wp-json/wc/v3
WC_CONSUMER_KEY=        # ck_xxx
WC_CONSUMER_SECRET=     # cs_xxx
WC_CURRENCY=USD

# ── Catalog cache + paging ─────────────────────────────────────
CATALOG_CACHE_TTL_MS=300000   # 5 min in-process TTL cache over WooCommerce responses
DEFAULT_PER_PAGE=12
