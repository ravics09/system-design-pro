# Copy to `.env` (read by docker compose). WooCommerce keys enable the catalog;
# everything else has sane defaults.

# ── WooCommerce REST API (product catalog) ─────────────────────
# A hostable WordPress/WooCommerce store. Create read-only REST API keys under
# WooCommerce → Settings → Advanced → REST API. These are SECRETS (server only,
# never shipped to the browser). Without them the app still runs — auth, cart,
# wishlist, addresses, and checkout work; the product listing just comes back
# empty with a hint.
WC_BASE_URL=            # e.g. https://your-store.example.com/wp-json/wc/v3
WC_CONSUMER_KEY=        # ck_xxx
WC_CONSUMER_SECRET=     # cs_xxx
WC_CURRENCY=USD

# Change this in any real deployment (used to sign access tokens).
JWT_ACCESS_SECRET=change-me-access-secret

# Token lifetimes (seconds)
ACCESS_TTL_S=900
REFRESH_TTL_S=2592000

# Catalog cache + paging
CATALOG_CACHE_TTL_MS=300000
DEFAULT_PER_PAGE=12

# Where the browser reaches the API (inlined into the web build)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3021
